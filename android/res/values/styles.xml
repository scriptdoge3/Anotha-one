<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Fullscreen, no action bar, and a window background matching the game's
         frame colour so there is no white flash while the WebView boots. -->
    <style name="AppTheme" parent="@android:style/Theme.NoTitleBar">
        <item name="android:windowBackground">@color/frame</item>
        <item name="android:statusBarColor">@color/frame</item>
        <item name="android:navigationBarColor">@color/frame</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
